  fhir:fhirVersion [ fhir:v "4.3.0"] ; # 
  fhir:mapping ( [
     fhir:identity [ fhir:v "rim" ] ;
     fhir:uri [
       fhir:v "http://hl7.org/v3"^^xsd:anyURI ;
       fhir:l <http://hl7.org/v3>
     ] ;
