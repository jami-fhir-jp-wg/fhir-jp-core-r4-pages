       ] )
     ] [
       fhir:id [ fhir:v "CarePlan.id" ] ;
       fhir:path [ fhir:v "CarePlan.id" ] ;
       fhir:short [ fhir:v "このアーティファクトの論理ID / Logical id of this artifact" ] ;
       fhir:definition [ fhir:v "リソースのURLで使用される論理ID。一度割り当てられたら、この値は変更されません。 / The logical id of the resource, as used in the URL for the resource. Once assigned, this value never changes." ] ;
       fhir:comment [ fhir:v "リソースにIDがないのは、作成操作を使用してサーバーに送信されているときだけです。 / The only time that a resource does not have an id is when it is being submitted to the server using a create operation." ] ;
       fhir:min [ fhir:v "0"^^xsd:nonNegativeInteger ] ;
       fhir:max [ fhir:v "1" ] ;
       fhir:base [
         fhir:path [ fhir:v "Resource.id" ] ;
         fhir:min [ fhir:v "0"^^xsd:nonNegativeInteger ] ;
         fhir:max [ fhir:v "1" ]
       ] ;
       fhir:type ( [
         fhir:extension ( [
           fhir:url [
             fhir:v "http://hl7.org/fhir/StructureDefinition/structuredefinition-fhir-type"^^xsd:anyURI ;
             fhir:l <http://hl7.org/fhir/StructureDefinition/structuredefinition-fhir-type>
           ] ;
           fhir:value [
             a fhir:Url ;
