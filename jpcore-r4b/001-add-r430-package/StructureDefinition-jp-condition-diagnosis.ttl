       fhir:isModifierReason [ fhir:v "修飾子拡張は、それを含む要素の意味または解釈を変更することが期待されます / Modifier extensions are expected to modify the meaning or interpretation of the element that contains them" ] ;
       fhir:isSummary [ fhir:v true ] ;
